{
  "name": "Frisky Design System — Telegram Bot UI (Deep Tech / Cyber)",
  "version": "1.0.0",
  "description": "Canonical design tokens for Frisky ecosystem Telegram bots, mini-apps, and portal UIs.",
  "colors": {
    "background": "#050505",
    "surface": {
      "glass": "rgba(255, 255, 255, 0.05)",
      "glassDark": "rgba(0, 0, 0, 0.4)",
      "elevated": "rgba(255, 255, 255, 0.08)",
      "card": "rgba(255, 255, 255, 0.03)"
    },
    "text": {
      "primary": "#ffffff",
      "body": "#cbd5e1",
      "muted": "#94a3b8",
      "technical": "#34d399"
    },
    "accent": {
      "gradientStart": "#c084fc",
      "gradientEnd": "#34d399",
      "purple": "#c084fc",
      "emerald": "#34d399",
      "blue": "#60a5fa",
      "amber": "#fbbf24",
      "red": "#f87171"
    },
    "border": "rgba(255, 255, 255, 0.1)",
    "glow": "rgba(192, 132, 252, 0.15)"
  },
  "typography": {
    "fontFamily": {
      "sans": "'Inter', 'Geist', 'Space Grotesk', system-ui, sans-serif",
      "mono": "'JetBrains Mono', 'Fira Code', monospace"
    },
    "heading": {
      "h1": { "size": "2.25rem", "weight": "700", "tracking": "-0.02em" },
      "h2": { "size": "1.5rem", "weight": "600", "tracking": "-0.01em" },
      "h3": { "size": "1.125rem", "weight": "600", "tracking": "0" }
    },
    "body": {
      "base": { "size": "0.875rem", "weight": "400", "lineHeight": "1.6" },
      "small": { "size": "0.75rem", "weight": "400", "lineHeight": "1.5" }
    },
    "technical": {
      "size": "0.75rem",
      "weight": "500",
      "tracking": "0.15em",
      "transform": "uppercase"
    },
    "mono": {
      "size": "0.8125rem",
      "weight": "500",
      "lineHeight": "1.4"
    }
  },
  "spacing": {
    "unit": "4px",
    "xs": "4px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px",
    "xl": "32px",
    "xxl": "40px"
  },
  "effects": {
    "glassmorphism": {
      "background": "rgba(255, 255, 255, 0.05)",
      "backdropBlur": "24px",
      "border": "1px solid rgba(255, 255, 255, 0.1)",
      "glow": "0 0 30px rgba(192, 132, 252, 0.1)"
    },
    "glow": {
      "premium": "0 0 30px rgba(192, 132, 252, 0.15)",
      "subtle": "0 0 15px rgba(192, 132, 252, 0.08)"
    }
  },
  "components": {
    "button": {
      "primary": {
        "background": "linear-gradient(135deg, #c084fc, #34d399)",
        "color": "#ffffff",
        "borderRadius": "8px",
        "padding": "12px 24px"
      },
      "secondary": {
        "background": "transparent",
        "border": "1px solid rgba(255, 255, 255, 0.2)",
        "color": "#cbd5e1",
        "borderRadius": "8px",
        "padding": "12px 24px"
      }
    },
    "card": {
      "glass": {
        "background": "rgba(255, 255, 255, 0.03)",
        "backdropBlur": "24px",
        "border": "1px solid rgba(255, 255, 255, 0.08)",
        "borderRadius": "12px",
        "padding": "24px"
      }
    },
    "badge": {
      "success": { "background": "rgba(52, 211, 153, 0.15)", "color": "#34d399" },
      "warning": { "background": "rgba(251, 191, 36, 0.15)", "color": "#fbbf24" },
      "error": { "background": "rgba(248, 113, 113, 0.15)", "color": "#f87171" },
      "info": { "background": "rgba(192, 132, 252, 0.15)", "color": "#c084fc" }
    },
    "telegram": {
      "inlineKeyboard": {
        "borderRadius": "8px",
        "buttonHeight": "40px",
        "buttonPadding": "8px 16px"
      },
      "botMessage": {
        "maxWidth": "400px",
        "borderRadius": "12px",
        "padding": "16px"
      },
      "miniApp": {
        "minHeight": "100vh",
        "background": "#050505",
        "safeAreaPadding": "env(safe-area-inset-top) env(safe-area-inset-right) env(safe-area-inset-bottom) env(safe-area-inset-left)"
      }
    }
  },
  "animation": {
    "duration": {
      "fast": "150ms",
      "normal": "300ms",
      "slow": "500ms"
    },
    "easing": {
      "ease": "cubic-bezier(0.4, 0, 0.2, 1)",
      "glow": "cubic-bezier(0.4, 0, 0.6, 1)"
    }
  }
}
